
# ============================================================
# .env.example — Configuration for Electric Vehicle Types Information Agent
# Copy this file to .env and fill in the required values.
# Variables marked as (pre-configured) are already set.
# ============================================================

# ══════════════════════════════════════════════════════════
# Agent Identity (PRELOADED)
# ══════════════════════════════════════════════════════════
AGENT_NAME=Electric Vehicle Types Information Agent  # Agent name (pre-configured)
AGENT_ID=ff73b79c-e8d5-4d4c-baa5-a702a558eded      # Agent unique identifier (pre-configured)
PROJECT_NAME=Electric_vehicle_info                          # Project name (pre-configured)
PROJECT_ID=59238f4d-657d-4b01-a41e-6a090dcc5a5c              # Project unique identifier (pre-configured)

# ══════════════════════════════════════════════════════════
# General Configuration
# ══════════════════════════════════════════════════════════
ENVIRONMENT=                         # Deployment environment (e.g., development, production)
SERVICE_NAME=                        # Service name for observability and logging
SERVICE_VERSION=                     # Service version number
MODEL_PROVIDER=openai
LLM_MODEL=gpt-4.1
LLM_TEMPERATURE=                     # Model temperature (0.0-2.0, controls randomness)
LLM_MAX_TOKENS=                      # Maximum tokens in model response
AZURE_OPENAI_ENDPOINT=https://kb-openai-01.openai.azure.com/openai/deployments/text-embedding-ada-002/embeddings?api-version=2023-05-15
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=                   # Anthropic API key (if using Anthropic provider)
GOOGLE_API_KEY=                      # Google API key (if using Google provider)
GITHUB_API_KEY=                      # GitHub API key
AZURE_SEARCH_ENDPOINT=               # Azure AI Search endpoint URL
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=electric-index
AZURE_CONTENT_SAFETY_ENDPOINT=https://az-ai-guardrails.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=
OBS_AZURE_SQL_SERVER=genaisqlserver.database.windows.net
OBS_AZURE_SQL_DATABASE=agentopsdatabase
OBS_AZURE_SQL_PORT=1433
OBS_AZURE_SQL_USERNAME=CloudSA4a0c2f31
OBS_AZURE_SQL_PASSWORD=
OBS_AZURE_SQL_SCHEMA=dbo
OBS_AZURE_SQL_TRUST_SERVER_CERTIFICATE=yes

USE_KEY_VAULT=                       # Enable Azure Key Vault integration (set to true for production)
KEY_VAULT_URI=                        # Azure Key Vault URI
AZURE_USE_DEFAULT_CREDENTIAL=         # Use DefaultAzureCredential for Key Vault (true for managed identity)

ENV_FILE_VARIABLES_LOADED=           # Flag indicating environment variables were loaded from .env
VALIDATION_CONFIG_PATH=code/validation_config.json
# (Note: VALIDATION_CONFIG_PATH is used by the agent code when loading validation rules)

# ══════════════════════════════════════════════════════════
# Azure Authentication
# ══════════════════════════════════════════════════════════
AZURE_TENANT_ID=eb06985d-06ca-4a17-81da-629ab99f6505
AZURE_CLIENT_ID=713245ca-5cc4-4db2-8f1a-c72ce2738243
AZURE_CLIENT_SECRET=                 # Azure AD client secret (if using service principal)

# ══════════════════════════════════════════════════════════
# LLM Configuration
# ══════════════════════════════════════════════════════════
MODEL_PROVIDER=openai
LLM_MODEL=gpt-4.1
LLM_TEMPERATURE=                     # Model temperature (0.0-2.0)
LLM_MAX_TOKENS=                      # Maximum tokens for model response
AZURE_OPENAI_ENDPOINT=https://kb-openai-01.openai.azure.com/openai/deployments/text-embedding-ada-002/embeddings?api-version=2023-05-15
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=                   # Anthropic API key
GOOGLE_API_KEY=                      # Google API key
GITHUB_API_KEY=                      # GitHub API key
AZURE_SEARCH_ENDPOINT=               # Azure AI Search endpoint URL (redundant key shown for clarity)
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=electric-index
AZURE_CONTENT_SAFETY_ENDPOINT=https://az-ai-guardrails.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=

# ══════════════════════════════════════════════════════════
# API Keys / Secrets
# ══════════════════════════════════════════════════════════
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=                   # Anthropic API key
GOOGLE_API_KEY=                      # Google API key
GITHUB_API_KEY=                      # GitHub API key
AZURE_SEARCH_API_KEY=
AZURE_CONTENT_SAFETY_KEY=
# (Note: Do not place platform-only credentials here; Observability credentials belong in Observability)

# ══════════════════════════════════════════════════════════
# Service Endpoints
# ══════════════════════════════════════════════════════════
AZURE_OPENAI_ENDPOINT=https://kb-openai-01.openai.azure.com/openai/deployments/text-embedding-ada-002/embeddings?api-version=2023-05-15
AZURE_SEARCH_ENDPOINT=                # Azure AI Search endpoint URL
AZURE_CONTENT_SAFETY_ENDPOINT=https://az-ai-guardrails.cognitiveservices.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_SEARCH_INDEX_NAME=electric-index
AZURE_SEARCH_API_KEY=
AZURE_CONTENT_SAFETY_KEY=

# ══════════════════════════════════════════════════════════
# Tool Integration
# ══════════════════════════════════════════════════════════
# (This agent has no tool integrations configured in this bundle)
# GRAPH_TENANT_ID=                    # If Graph integration is used
# GRAPH_CLIENT_ID=                    # Graph client ID
# GRAPH_CLIENT_SECRET=                # Graph client secret
# GRAPH_USER_ID=                      # Graph user ID

# ══════════════════════════════════════════════════════════
# Observability
# ══════════════════════════════════════════════════════════
OBS_DATABASE_TYPE=azure_sql
OBS_AZURE_SQL_SERVER=genaisqlserver.database.windows.net
OBS_AZURE_SQL_DATABASE=agentopsdatabase
OBS_AZURE_SQL_PORT=1433
OBS_AZURE_SQL_USERNAME=CloudSA4a0c2f31
OBS_AZURE_SQL_PASSWORD=
OBS_AZURE_SQL_SCHEMA=dbo
OBS_AZURE_SQL_TRUST_SERVER_CERTIFICATE=yes

# ══════════════════════════════════════════════════════════
# Agent-Specific
# ══════════════════════════════════════════════════════════
VALIDATION_CONFIG_PATH=code/validation_config.json
ENV_FILE_VARIABLES_LOADED=              # Flag indicating env vars loaded from .env
PRIMARY_ADMIN_KEY=                     # Optional admin key for internal tooling
# Note: If your environment uses Key Vault, ensure KEY_VAULT_URI is set and USE_KEY_VAULT=true.
